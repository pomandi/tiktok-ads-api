# App olusturulduktan SONRA portal/apps sayfasindan kopyala
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Formdaki redirect URL ile birebir AYNI olmali
TIKTOK_REDIRECT_URI=https://tiktok.pomandi.com/oauth/callback

# /oauth/start ve /token endpoint'lerini korur (rastgele uzun bir string uret)
START_SECRET=

# Token'in saklanacagi klasor (Coolify'da persistent volume mount et)
DATA_DIR=/data
